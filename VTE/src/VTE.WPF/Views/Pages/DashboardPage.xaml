<UserControl
    x:Class="VTE.WPF.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Quick Action Button Style -->
        <Style x:Key="QuickActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBgHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OuterBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SurfaceBg}"/>
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Title Style -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource PageBg}">
        <StackPanel Margin="32,28,32,32">

            <!-- Header -->
            <StackPanel Margin="0,0,0,4">
                <TextBlock x:Name="TxtGreeting" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="TxtDate" FontSize="13" Foreground="{DynamicResource TextSubtle}" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Stat Cards Row -->
            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Customers Card -->
                <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource StatBlue}">
                    <Grid>
                        <!-- Left accent stripe -->
                        <Border Background="#3b82f6" Width="4" HorizontalAlignment="Left" CornerRadius="2,0,0,2"/>
                        <Grid Margin="20,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="LblCustomers" Text="CUSTOMERS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource StatLabel}"
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtCustomers" Text="0" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="LblCustomersSub" Text="registered" FontSize="11.5" Foreground="{DynamicResource StatSubtext}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="46" Height="46" CornerRadius="23"
                                    VerticalAlignment="Top" Margin="8,0,0,0">
                                <Border.Background>
                                    <SolidColorBrush Color="#3b82f6" Opacity="0.15"/>
                                </Border.Background>
                                <TextBlock Text="&#x1F465;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Vehicles Card -->
                <Border Grid.Column="2" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource StatTeal}">
                    <Grid>
                        <Border Background="#06b6d4" Width="4" HorizontalAlignment="Left" CornerRadius="2,0,0,2"/>
                        <Grid Margin="20,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="LblVehicles" Text="VEHICLES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource StatLabel}"
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtVehicles" Text="0" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="LblVehiclesSub" Text="in registry" FontSize="11.5" Foreground="{DynamicResource StatSubtext}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="46" Height="46" CornerRadius="23"
                                    VerticalAlignment="Top" Margin="8,0,0,0">
                                <Border.Background>
                                    <SolidColorBrush Color="#06b6d4" Opacity="0.15"/>
                                </Border.Background>
                                <TextBlock Text="&#x1F697;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Exams Today Card -->
                <Border Grid.Column="4" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource StatGreen}">
                    <Grid>
                        <Border Background="#22c55e" Width="4" HorizontalAlignment="Left" CornerRadius="2,0,0,2"/>
                        <Grid Margin="20,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="LblExamsToday" Text="EXAMS TODAY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource StatLabel}"
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtExamsToday" Text="0" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="LblExamsTodaySub" Text="inspections" FontSize="11.5" Foreground="{DynamicResource StatSubtext}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="46" Height="46" CornerRadius="23"
                                    VerticalAlignment="Top" Margin="8,0,0,0">
                                <Border.Background>
                                    <SolidColorBrush Color="#22c55e" Opacity="0.15"/>
                                </Border.Background>
                                <TextBlock Text="&#x1F50D;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Hidden unpaid elements for code-behind -->
                <TextBlock x:Name="LblUnpaid" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtUnpaid" Visibility="Collapsed"/>
                <TextBlock x:Name="LblUnpaidSub" Visibility="Collapsed"/>
            </Grid>

            <!-- Second Row: Quick Actions + Recent Activity -->
            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Quick Actions -->
                <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="22" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="LblQuickActions" Text="Quick Actions" Style="{StaticResource SectionTitle}"/>
                        <UniformGrid Columns="2" Rows="3">
                            <Button Style="{StaticResource QuickActionBtn}"
                                    Click="QuickNewCustomer" Margin="0,0,8,8" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2795;" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtQNewCustomer" Text="New Customer" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionBtn}"
                                    Click="QuickNewVehicle" Margin="8,0,0,8" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x1F697;" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtQRegisterVehicle" Text="Register Vehicle" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionBtn}"
                                    Click="QuickNewExam" Margin="0,0,8,8" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x1F50D;" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtQNewExam" Text="New Technical Exam" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionBtn}"
                                    Click="QuickNewRequest" Margin="8,0,0,8" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x1F4DD;" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtQNewRequest" Text="New Request" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionBtn}"
                                    Click="QuickNewPayment" Margin="0,0,8,0" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x1F4B3;" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtQNewPayment" Text="New Payment" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Наплата (Payment Tree) -->
                <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="22"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock Text="Наплата" Style="{StaticResource SectionTitle}" DockPanel.Dock="Top"/>
                        <TextBlock x:Name="TxtPaymentTotal" DockPanel.Dock="Bottom"
                                   HorizontalAlignment="Right" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <StackPanel x:Name="PaymentTreePanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Hidden ActivityList for code-behind -->
                <StackPanel x:Name="ActivityList" Visibility="Collapsed"/>
                <TextBlock x:Name="LblRecentActivity" Visibility="Collapsed"/>
            </Grid>


        </StackPanel>
    </ScrollViewer>
</UserControl>
