<UserControl
    x:Class="VTE.WPF.Views.Pages.RequestWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VTE.WPF.Controls">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="{DynamicResource PageBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#a6c9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#a6c9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepIndicator" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="FlagLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Back Button -->
        <Button x:Name="BtnBack" Grid.Row="0" Content="&lt; Back to List" Style="{StaticResource BackButton}"
                Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <!-- Title -->
        <TextBlock x:Name="PageTitle" Grid.Row="1" Text="New Request" FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

        <!-- Step Indicator -->
        <TextBlock x:Name="TxtStepIndicator" Grid.Row="2" Style="{StaticResource StepIndicator}"/>

        <!-- Step Panels -->
        <Grid Grid.Row="3">
            <!-- ==================== STEP 1: Select Request Type ==================== -->
            <Border x:Name="Step1Panel" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="20" Visibility="Visible">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="LblStep1Title" Grid.Row="0" Text="Select Request Type" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Request Types List -->
                        <DataGrid x:Name="RequestTypesGrid" Grid.Column="0"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource GridBorder}"
                                  BorderBrush="{DynamicResource GridBorder}" BorderThickness="1"
                                  Background="{DynamicResource CardBg}"
                                  RowBackground="{DynamicResource GridRowBg}"
                                  AlternatingRowBackground="{DynamicResource GridRowAltBg}"
                                  Foreground="{DynamicResource TextSecondary}" FontSize="13"
                                  SelectionChanged="RequestTypesGrid_SelectionChanged">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource GridBorder}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#45475a"/>
                                            <Setter Property="Foreground" Value="#cdd6f4"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#313244"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#45475a"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Flags Display -->
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBg}" CornerRadius="6" Padding="16">
                            <StackPanel x:Name="FlagsPanel">
                                <TextBlock Text="Details" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="TxtFlagTechExam" Style="{StaticResource FlagLabel}"/>
                                <TextBlock x:Name="TxtFlagPayRequired" Style="{StaticResource FlagLabel}"/>
                                <TextBlock x:Name="TxtFlagNewRegistration" Style="{StaticResource FlagLabel}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ==================== STEP 2: Select Customer & Vehicle ==================== -->
            <Border x:Name="Step2Panel" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="20" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="LblStep2Title" Grid.Row="0" Text="Select Customer &amp; Vehicle" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                    <!-- Existing relation combo -->
                    <StackPanel Grid.Row="1">
                        <TextBlock x:Name="LblExistingRelation" Text="Customer-Vehicle Relation" Style="{StaticResource FieldLabel}"/>
                        <controls:SearchableLookupPicker x:Name="PickerCustomerVehicleRelation" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- Search panels side by side -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Customer Search -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBg}" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="LblSearchCustomer" Grid.Row="0" Text="Search Customer" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCustomerSearch" Grid.Column="0" Style="{StaticResource SearchBox}" Margin="0,0,8,0"
                                             KeyDown="CustomerSearch_KeyDown"/>
                                    <Button x:Name="BtnSearchCustomer" Grid.Column="1" Content="Search" Style="{StaticResource PlainButton}"
                                            Click="SearchCustomer_Click"/>
                                </Grid>

                                <DataGrid x:Name="CustomersGrid" Grid.Row="2"
                                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource GridBorder}"
                                          BorderBrush="{DynamicResource GridBorder}" BorderThickness="1"
                                          Background="{DynamicResource CardBg}"
                                          RowBackground="{DynamicResource GridRowBg}"
                                          AlternatingRowBackground="{DynamicResource GridRowAltBg}"
                                          Foreground="{DynamicResource TextSecondary}" FontSize="13">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource GridBorder}"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#45475a"/>
                                                    <Setter Property="Foreground" Value="#cdd6f4"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#313244"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#45475a"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="ID Number" Binding="{Binding IdentificationNumber}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Vehicle Search -->
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBg}" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="LblSearchVehicle" Grid.Row="0" Text="Search Vehicle" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtVehicleSearch" Grid.Column="0" Style="{StaticResource SearchBox}" Margin="0,0,8,0"
                                             KeyDown="VehicleSearch_KeyDown"/>
                                    <Button x:Name="BtnSearchVehicle" Grid.Column="1" Content="Search" Style="{StaticResource PlainButton}"
                                            Click="SearchVehicle_Click"/>
                                </Grid>

                                <DataGrid x:Name="VehiclesGrid" Grid.Row="2"
                                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource GridBorder}"
                                          BorderBrush="{DynamicResource GridBorder}" BorderThickness="1"
                                          Background="{DynamicResource CardBg}"
                                          RowBackground="{DynamicResource GridRowBg}"
                                          AlternatingRowBackground="{DynamicResource GridRowAltBg}"
                                          Foreground="{DynamicResource TextSecondary}" FontSize="13">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource GridBorder}"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#45475a"/>
                                                    <Setter Property="Foreground" Value="#cdd6f4"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#313244"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#45475a"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Reg. Number" Binding="{Binding RegNumber}" Width="*"/>
                                        <DataGridTextColumn Header="Shell Number" Binding="{Binding ShellNumber}" Width="160"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ==================== STEP 3: Document Checklist ==================== -->
            <Border x:Name="Step3Panel" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="LblStep3Title" Text="Document Checklist" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

                    <CheckBox x:Name="ChkOwnershipProof" Content="Ownership Proof" Foreground="{DynamicResource TextSecondary}" FontSize="14"
                              Margin="0,0,0,12"/>

                    <CheckBox x:Name="ChkPaymentProof" Content="Payment Proof" Foreground="{DynamicResource TextSecondary}" FontSize="14"
                              Margin="0,0,0,16"/>

                    <TextBlock x:Name="LblDocNote" Text="Note" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtDocNote" Style="{StaticResource FieldBox}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <!-- ==================== STEP 4: Technical Exam ==================== -->
            <Border x:Name="Step4Panel" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="LblStep4Title" Text="Technical Exam" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

                    <TextBlock x:Name="TxtExamInfo" Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Border x:Name="ExamDetailsBorder" Background="{DynamicResource SurfaceBg}" CornerRadius="6" Padding="16" Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtExamDate" Style="{StaticResource FlagLabel}"/>
                            <TextBlock x:Name="TxtExamValidUntil" Style="{StaticResource FlagLabel}"/>
                            <TextBlock x:Name="TxtExamResult" Style="{StaticResource FlagLabel}"/>
                            <TextBlock x:Name="TxtExamRegNumber" Style="{StaticResource FlagLabel}"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnCreateExam" Content="Create New Exam" Style="{StaticResource PlainButton}"
                            Click="CreateExam_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- ==================== STEP 5: Summary & Complete ==================== -->
            <Border x:Name="Step5Panel" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="20" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="LblStep5Title" Text="Summary &amp; Complete" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

                        <TextBlock x:Name="LblSumRequestType" Text="Request Type" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="TxtSumRequestType" Style="{StaticResource SummaryValue}"/>

                        <TextBlock x:Name="LblSumCustomer" Text="Customer" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="TxtSumCustomer" Style="{StaticResource SummaryValue}"/>

                        <TextBlock x:Name="LblSumVehicle" Text="Vehicle" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="TxtSumVehicle" Style="{StaticResource SummaryValue}"/>

                        <TextBlock x:Name="LblSumDocuments" Text="Documents" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="TxtSumDocuments" Style="{StaticResource SummaryValue}" TextWrapping="Wrap"/>

                        <TextBlock x:Name="LblSumExam" Text="Exam Status" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="TxtSumExam" Style="{StaticResource SummaryValue}" TextWrapping="Wrap"/>

                        <TextBlock x:Name="LblSumNote" Text="Note" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="TxtSumNote" Style="{StaticResource SummaryValue}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Navigation Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnPrevious" Content="&lt; Previous" Style="{StaticResource PlainButton}"
                    Click="Previous_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="BtnNext" Content="Next &gt;" Style="{StaticResource AccentButton}"
                    Click="Next_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnComplete" Content="Complete Request" Style="{StaticResource AccentButton}"
                    Click="Complete_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
