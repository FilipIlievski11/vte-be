<UserControl
    x:Class="VTE.WPF.Views.Pages.PaymentDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VTE.WPF.Controls"
    xmlns:controls="clr-namespace:VTE.WPF.Controls">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="{DynamicResource PageBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#a6c9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnDangerBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PageBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f5a0b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#a6c9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with back button + title -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1" Padding="0,12,0,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBack" Grid.Column="0" Click="Back_Click" Cursor="Hand"
                        Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource AccentBlue}"
                        BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                        Padding="12,8" FontSize="13" Margin="0,0,16,0"
                        VerticalAlignment="Center" Content="&#x2190;  Назад кон листа"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="New Payment" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 -->
                            <TextBlock x:Name="LblDocumentNumber" Grid.Row="0" Grid.Column="0" Text="Document Number *"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtDocumentNumber" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblRelation" Grid.Row="0" Grid.Column="3" Text="Customer-Vehicle Relation *"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <local:SearchableRelationPicker x:Name="RelationPicker" Grid.Row="0" Grid.Column="4" Margin="0,0,0,12"/>

                            <!-- Row 1 -->
                            <TextBlock x:Name="LblPaymentDate" Grid.Row="1" Grid.Column="0" Text="Payment Date"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <DatePicker x:Name="DpPaymentDate" Grid.Row="1" Grid.Column="1"
                                        Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextSecondary}"
                                        BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="6" FontSize="13" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblPaymentType" Grid.Row="1" Grid.Column="3" Text="Payment Type *"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerPaymentType" Grid.Row="1" Grid.Column="4" Margin="0,0,0,12"/>

                            <!-- Row 2 -->
                            <TextBlock x:Name="LblDueDate" Grid.Row="2" Grid.Column="0" Text="Due Date"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <DatePicker x:Name="DpDueDate" Grid.Row="2" Grid.Column="1"
                                        Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextSecondary}"
                                        BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="6" FontSize="13" Margin="0,0,0,12"/>

                            <CheckBox x:Name="ChkIsPaid" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"
                                      Content="  Is Paid" Foreground="{DynamicResource TextSecondary}" FontSize="13"
                                      VerticalAlignment="Center" Margin="0,0,0,12"/>

                            <!-- Row 3 -->
                            <TextBlock x:Name="LblDiscount" Grid.Row="3" Grid.Column="0" Text="Discount Percent"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtDiscountPercent" Grid.Row="3" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <CheckBox x:Name="ChkIsCancelled" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2"
                                      Content="  Is Cancelled" Foreground="{DynamicResource TextSecondary}" FontSize="13"
                                      VerticalAlignment="Center" Margin="0,0,0,12"/>

                            <!-- Row 4: Note full width -->
                            <TextBlock x:Name="LblNote" Grid.Row="4" Grid.Column="0" Text="Note"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtNote" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                     Style="{StaticResource FieldBox}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto"/>
                        </Grid>

                        <!-- Line Items Section -->
                        <TextBlock x:Name="LblLineItems" Text="Line Items" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,8"/>

                        <DataGrid x:Name="LineItemsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource GridBorder}"
                                  BorderBrush="{DynamicResource GridBorder}"
                                  BorderThickness="1"
                                  Background="{DynamicResource CardBg}"
                                  RowBackground="{DynamicResource GridRowBg}"
                                  AlternatingRowBackground="{DynamicResource GridRowAltBg}"
                                  Foreground="{DynamicResource TextSecondary}"
                                  FontSize="13"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  MinHeight="120"
                                  MaxHeight="300">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource GridBorder}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#45475a"/>
                                            <Setter Property="Foreground" Value="#cdd6f4"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#313244"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#45475a"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColDescription" Header="Опис" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn x:Name="ColQuantity" Header="Кол." Binding="{Binding Quantity}" Width="60"/>
                                <DataGridTextColumn x:Name="ColUnitPrice" Header="Цена" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100"/>
                                <DataGridTextColumn x:Name="ColVAT" Header="ДДВ %" Binding="{Binding VATPercent, StringFormat=N2}" Width="70"/>
                                <DataGridTextColumn x:Name="ColTotal" Header="Вкупно" Binding="{Binding TotalAmount, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Separator + Buttons inside card -->
                        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnSave" Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnDelete" Content="Delete" Style="{StaticResource DeleteButton}" Click="Delete_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource CancelButton}" Click="Back_Click"/>
                                <Button x:Name="BtnPrint" Content="Печати фактура" Click="Print_Click"
                                        Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource TextSecondary}"
                                        BorderThickness="0" Padding="16,8" FontSize="13" Margin="8,0,0,0" Cursor="Hand"/>
                                <Button x:Name="BtnPrintReceipt" Content="Печати сметка" Click="PrintReceipt_Click"
                                        Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource TextSecondary}"
                                        BorderThickness="0" Padding="16,8" FontSize="13" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
