<UserControl
    x:Class="VTE.WPF.Views.Pages.AdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VTE.WPF.Controls">

    <UserControl.Resources>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="{DynamicResource PageBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#a6c9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnDangerBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PageBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f5a0b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextSecondary}"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Administration - Users" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="+ New User" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="NewUser_Click"/>
            <Button Content="Edit Selected" Style="{StaticResource PlainButton}" Margin="0,0,8,0" Click="EditUser_Click"/>
            <Button Content="Delete Selected" Style="{StaticResource DangerButton}" Click="DeleteUser_Click"/>
        </StackPanel>

        <!-- Content: DataGrid + Edit Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <DataGrid x:Name="UsersGrid" Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource GridBorder}"
                      BorderBrush="{DynamicResource GridBorder}"
                      BorderThickness="1"
                      Background="{DynamicResource CardBg}"
                      RowBackground="{DynamicResource GridRowBg}"
                      AlternatingRowBackground="{DynamicResource GridRowAltBg}"
                      Foreground="{DynamicResource TextSecondary}"
                      FontSize="13"
                      CanUserSortColumns="True">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GridBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                                <Setter Property="Foreground" Value="#cdd6f4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#313244"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="120"/>
                    <DataGridTextColumn Header="Organization" Binding="{Binding OrganizationName}" Width="160"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                    <DataGridTextColumn Header="Date of Hiring" Binding="{Binding DateOfHiring, StringFormat=\{0:dd.MM.yyyy\}}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Edit Panel -->
            <Border x:Name="EditPanel" Grid.Column="1" Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="12,0,0,0"
                    Width="320" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="EditPanelTitle" Text="New User" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                        <TextBlock Text="Username" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtUsername" Style="{StaticResource FormTextBox}"/>

                        <TextBlock x:Name="LblPassword" Text="Password" Style="{StaticResource FormLabel}"/>
                        <PasswordBox x:Name="TxtPassword" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextSecondary}"
                                     BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="8,6" FontSize="13"/>

                        <TextBlock Text="First Name" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtFirstName" Style="{StaticResource FormTextBox}"/>

                        <TextBlock Text="Last Name" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtLastName" Style="{StaticResource FormTextBox}"/>

                        <TextBlock Text="Full Name" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtFullName" Style="{StaticResource FormTextBox}"/>

                        <TextBlock Text="Role" Style="{StaticResource FormLabel}"/>
                        <controls:SearchableLookupPicker x:Name="PickerRole" Margin="0,0,0,4"/>

                        <TextBlock Text="Organization" Style="{StaticResource FormLabel}"/>
                        <controls:SearchableLookupPicker x:Name="PickerOrganization" Margin="0,0,0,4"/>

                        <CheckBox x:Name="ChkIsActive" Content="Is Active" Foreground="{DynamicResource TextSecondary}" Margin="0,12,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Save" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="SaveUser_Click"/>
                            <Button Content="Cancel" Style="{StaticResource PlainButton}" Click="CancelEdit_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
