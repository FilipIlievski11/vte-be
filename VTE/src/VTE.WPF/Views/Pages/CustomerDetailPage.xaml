<UserControl
    x:Class="VTE.WPF.Views.Pages.CustomerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="{DynamicResource PageBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#a6c9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnDangerBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PageBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f5a0b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#a6c9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with back button + title -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1" Padding="0,12,0,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBack" Grid.Column="0" Click="Back_Click" Cursor="Hand"
                        Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource AccentBlue}"
                        BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                        Padding="12,8" FontSize="13" Margin="0,0,16,0"
                        VerticalAlignment="Center" Content="&#x2190;  Назад кон листа"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="Нов клиент" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Single card with all fields in a structured grid -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Име / Презиме -->
                        <TextBlock x:Name="LblFirstName" Grid.Row="0" Grid.Column="0" Text="Име *"
                                   Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                        <TextBox x:Name="TxtFirstName" Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource FieldBox}"/>

                        <TextBlock x:Name="LblLastName" Grid.Row="0" Grid.Column="3" Text="Презиме *"
                                   Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                        <TextBox x:Name="TxtLastName" Grid.Row="0" Grid.Column="4"
                                 Style="{StaticResource FieldBox}"/>

                        <!-- Row 1: Датум на раѓање / Матичен број -->
                        <TextBlock x:Name="LblDateOfBirth" Grid.Row="1" Grid.Column="0" Text="Датум на раѓање"
                                   Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                        <TextBox x:Name="TxtDateOfBirth" Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource FieldBox}"/>

                        <TextBlock x:Name="LblIdentificationNumber" Grid.Row="1" Grid.Column="3" Text="Матичен број"
                                   Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                        <TextBox x:Name="TxtIdentificationNumber" Grid.Row="1" Grid.Column="4"
                                 Style="{StaticResource FieldBox}"/>

                        <!-- Row 2: Телефон / Е-пошта -->
                        <TextBlock x:Name="LblPhoneNumber" Grid.Row="2" Grid.Column="0" Text="Телефон"
                                   Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                        <TextBox x:Name="TxtPhoneNumber" Grid.Row="2" Grid.Column="1"
                                 Style="{StaticResource FieldBox}"/>

                        <TextBlock x:Name="LblEmail" Grid.Row="2" Grid.Column="3" Text="Е-пошта"
                                   Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                        <TextBox x:Name="TxtEmail" Grid.Row="2" Grid.Column="4"
                                 Style="{StaticResource FieldBox}"/>

                        <!-- Row 3: Адреса / Правно лице -->
                        <TextBlock x:Name="LblCity" Grid.Row="3" Grid.Column="0" Text="Адреса на живеење"
                                   Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                        <TextBox x:Name="TxtCity" Grid.Row="3" Grid.Column="1"
                                 Style="{StaticResource FieldBox}" IsReadOnly="True"/>

                        <CheckBox x:Name="ChkIsCompany" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2"
                                  Content="  Правно лице" Foreground="{DynamicResource TextSecondary}" FontSize="14"
                                  VerticalAlignment="Center" Margin="0,0,0,12"/>

                        <!-- Row 4: Забелешка (full width) -->
                        <TextBlock x:Name="LblNote" Grid.Row="4" Grid.Column="0" Text="Забелешка"
                                   Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,0,8,12"/>
                        <TextBox x:Name="TxtNote" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                 Style="{StaticResource FieldBox}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <!-- Separator + Buttons inside card -->
                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnSave" Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click" Margin="0,0,8,0"/>
                            <Button x:Name="BtnDelete" Content="Delete" Style="{StaticResource DeleteButton}" Click="Delete_Click" Margin="0,0,8,0"/>
                            <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource CancelButton}" Click="Back_Click"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Border>

                <!-- Hidden fields -->
                <TextBox x:Name="TxtParentName" Visibility="Collapsed"/>
                <TextBox x:Name="TxtIdentityCardNumber" Visibility="Collapsed"/>
                <TextBox x:Name="TxtDrivingLicenseNumber" Visibility="Collapsed"/>
                <TextBox x:Name="TxtCompanyName" Visibility="Collapsed"/>
                <TextBox x:Name="TxtTaxNumber" Visibility="Collapsed"/>
                <TextBox x:Name="TxtFax" Visibility="Collapsed"/>
                <TextBox x:Name="TxtOccupation" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
