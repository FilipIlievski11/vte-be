<UserControl
    x:Class="VTE.WPF.Views.Pages.ExamDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VTE.WPF.Controls"
    xmlns:controls="clr-namespace:VTE.WPF.Controls">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,10"/>
        </Style>

        <Style x:Key="StyledDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="{DynamicResource PageBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#a6c9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnDangerBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PageBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f5a0b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#a6c9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with back button + title -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1" Padding="0,12,0,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBack" Grid.Column="0" Click="Back_Click" Cursor="Hand"
                        Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource AccentBlue}"
                        BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                        Padding="12,8" FontSize="13" Margin="0,0,16,0"
                        VerticalAlignment="Center" Content="&#x2190;  Назад кон листа"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="New Exam" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>

                <!-- Card 1: General -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblGeneral" Text="General" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 -->
                            <TextBlock x:Name="LblRegistrationNumber" Grid.Row="0" Grid.Column="0" Text="Registration Number *"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtRegistrationNumber" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblExamType" Grid.Row="0" Grid.Column="3" Text="Exam Type *"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerExamType" Grid.Row="0" Grid.Column="4" Margin="0,0,0,12"/>

                            <!-- Row 1 -->
                            <TextBlock x:Name="LblExamDate" Grid.Row="1" Grid.Column="0" Text="Exam Date *"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <DatePicker x:Name="DpExamDate" Grid.Row="1" Grid.Column="1" Style="{StaticResource StyledDatePicker}"/>

                            <TextBlock x:Name="LblOrganization" Grid.Row="1" Grid.Column="3" Text="Organization *"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerOrganization" Grid.Row="1" Grid.Column="4" Margin="0,0,0,12"/>

                            <!-- Row 2 -->
                            <TextBlock x:Name="LblValidUntilDate" Grid.Row="2" Grid.Column="0" Text="Valid Until Date *"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <DatePicker x:Name="DpValidUntilDate" Grid.Row="2" Grid.Column="1" Style="{StaticResource StyledDatePicker}"/>

                            <TextBlock x:Name="LblFirstController" Grid.Row="2" Grid.Column="3" Text="First Controller *"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerFirstController" Grid.Row="2" Grid.Column="4" Margin="0,0,0,12"/>

                            <!-- Row 3 -->
                            <CheckBox x:Name="ChkVehiclePassed" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Vehicle Passed" Foreground="{DynamicResource TextSecondary}" FontSize="13"
                                      VerticalAlignment="Center" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblRelation" Grid.Row="3" Grid.Column="3" Text="Customer Vehicle Relation *"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <local:SearchableRelationPicker x:Name="RelationPicker" Grid.Row="3" Grid.Column="4" Margin="0,0,0,12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Brake Measurements -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblBrakeAxle1" Text="Brake Measurements - Axle 1" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Left KN" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAxle1BrakeLeftKN" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Right KN" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAxle1BrakeRightKN" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Gj" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAxle1BrakeGj" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Left Pj" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAxle1BrakeLeftPj" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="PN" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAxle1BrakePN" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="LblBrakeAxle2" Text="Brake Measurements - Axle 2" Style="{StaticResource SectionHeader}" Margin="0,8,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Left KN" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAxle2BrakeLeftKN" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Right KN" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAxle2BrakeRightKN" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Gj" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAxle2BrakeGj" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Left Pj" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAxle2BrakeLeftPj" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="PN" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAxle2BrakePN" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="LblBrakeEffectiveness" Text="Brake Effectiveness" Style="{StaticResource SectionHeader}" Margin="0,8,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="LblWorkingBrakeEmpty" Grid.Row="0" Grid.Column="0" Text="Working Brake (Empty)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtWorkingBrakeEffectivenessEmpty" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblParkingBrake" Grid.Row="0" Grid.Column="3" Text="Parking Brake"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtParkingBrakeEffectiveness" Grid.Row="0" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblWorkingBrakeFull" Grid.Row="1" Grid.Column="0" Text="Working Brake (Full)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtWorkingBrakeEffectivenessFull" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblVehicleWeight" Grid.Row="1" Grid.Column="3" Text="Vehicle Weight (KG)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtVehicleWeightKG" Grid.Row="1" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblSecondaryBrake" Grid.Row="2" Grid.Column="0" Text="Secondary Brake"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtSecondaryBrakeEffectiveness" Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Emissions -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblEmissions" Text="Emissions" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="LblEngineSpeed" Grid.Row="0" Grid.Column="0" Text="Engine Speed (RPM)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtEngineSpeedRPM" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblLambda" Grid.Row="0" Grid.Column="3" Text="Lambda"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtLambda" Grid.Row="0" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="CO"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtCO" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblPinpoints" Grid.Row="1" Grid.Column="3" Text="Pinpoints"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtPinpoints" Grid.Row="1" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblEngineTurns" Grid.Row="2" Grid.Column="0" Text="Engine Turns"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtEngineTurns" Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblNoiseDB" Grid.Row="2" Grid.Column="3" Text="Noise (dB)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtNoiseDB" Grid.Row="2" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblCOPlusTurns" Grid.Row="3" Grid.Column="0" Text="CO + Turns"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtCOPlusTurns" Grid.Row="3" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblEngineOilTemp" Grid.Row="3" Grid.Column="3" Text="Engine Oil Temp (C)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtEngineOilTemperatureC" Grid.Row="3" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 4: Notes -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblNotes" Text="Notes" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>

                        <TextBlock x:Name="LblTechnicalChanges" Text="Technical Changes" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtTechnicalChanges" Style="{StaticResource FieldBox}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto"/>

                        <TextBlock x:Name="LblExplanationNote" Text="Explanation Note" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtExplanationNote" Style="{StaticResource FieldBox}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto"/>

                        <TextBlock x:Name="LblDriverWarning" Text="Driver Warning" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtDriverWarning" Style="{StaticResource FieldBox}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto"/>

                        <TextBlock x:Name="LblNote" Text="Note" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtNote" Style="{StaticResource FieldBox}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto"/>

                        <!-- Separator + Buttons inside card -->
                        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnSave" Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnDelete" Content="Delete" Style="{StaticResource DeleteButton}" Click="Delete_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource CancelButton}" Click="Back_Click"/>
                                <Button x:Name="BtnPrintReport" Content="Печати извештај" Click="PrintReport_Click"
                                        Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource TextSecondary}"
                                        BorderThickness="0" Padding="16,8" FontSize="13" Margin="8,0,0,0" Cursor="Hand"/>
                                <Button x:Name="BtnPrintCertificate" Content="Печати потврда" Click="PrintCertificate_Click"
                                        Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource TextSecondary}"
                                        BorderThickness="0" Padding="16,8" FontSize="13" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
