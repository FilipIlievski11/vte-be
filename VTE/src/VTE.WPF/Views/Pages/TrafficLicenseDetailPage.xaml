<UserControl
    x:Class="VTE.WPF.Views.Pages.TrafficLicenseDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VTE.WPF.Controls">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="{DynamicResource PageBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#a6c9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnDangerBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PageBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f5a0b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#a6c9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with back button + title -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1" Padding="0,12,0,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBack" Grid.Column="0" Click="Back_Click" Cursor="Hand"
                        Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource AccentBlue}"
                        BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                        Padding="12,8" FontSize="13" Margin="0,0,16,0"
                        VerticalAlignment="Center" Content="&#x2190;  Назад кон листа"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="New Traffic License" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 -->
                            <TextBlock x:Name="LblLicenseNumber" Grid.Row="0" Grid.Column="0" Text="License Number *"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtLicenseNumber" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblRelation" Grid.Row="0" Grid.Column="3" Text="Customer-Vehicle *"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerRelation" Grid.Row="0" Grid.Column="4" Margin="0,0,0,12"/>

                            <!-- Row 1 -->
                            <TextBlock x:Name="LblPlateNumber" Grid.Row="1" Grid.Column="0" Text="Plate Number"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtPlateNumber" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblDocumentId" Grid.Row="1" Grid.Column="3" Text="Document ID"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtDocumentId" Grid.Row="1" Grid.Column="4"
                                     Style="{StaticResource FieldBox}" IsReadOnly="True" Opacity="0.6"/>

                            <!-- Row 2 -->
                            <TextBlock x:Name="LblIssuedDate" Grid.Row="2" Grid.Column="0" Text="Issued Date"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <DatePicker x:Name="DpIssuedDate" Grid.Row="2" Grid.Column="1"
                                        Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextSecondary}"
                                        BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="6" FontSize="13" Margin="0,0,0,12"/>

                            <!-- Row 3 -->
                            <TextBlock x:Name="LblValidUntil" Grid.Row="3" Grid.Column="0" Text="Valid Until"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <DatePicker x:Name="DpValidUntil" Grid.Row="3" Grid.Column="1"
                                        Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextSecondary}"
                                        BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="6" FontSize="13" Margin="0,0,0,12"/>

                            <!-- Row 4: Note full width -->
                            <TextBlock x:Name="LblNote" Grid.Row="4" Grid.Column="0" Text="Note"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtNote" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                     Style="{StaticResource FieldBox}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto"/>
                        </Grid>

                        <!-- Separator + Buttons inside card -->
                        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnSave" Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnDelete" Content="Delete" Style="{StaticResource DeleteButton}" Click="Delete_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource CancelButton}" Click="Back_Click"/>
                                <Button x:Name="BtnPrint" Content="Печати" Click="Print_Click"
                                        Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource TextSecondary}"
                                        BorderThickness="0" Padding="16,8" FontSize="13" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
