<UserControl
    x:Class="VTE.WPF.Views.Pages.VehicleDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VTE.WPF.Controls">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="FieldDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,10"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="{DynamicResource PageBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#a6c9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnDangerBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PageBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f5a0b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#a6c9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with back button + title -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1" Padding="0,12,0,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBack" Grid.Column="0" Click="Back_Click" Cursor="Hand"
                        Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource AccentBlue}"
                        BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                        Padding="12,8" FontSize="13" Margin="0,0,16,0"
                        VerticalAlignment="Center" Content="&#x2190;  Назад кон листа"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="New Vehicle" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>

                <!-- Card 1: Registration -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblRegistration" Text="Registration" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 -->
                            <TextBlock x:Name="LblShellNumber" Grid.Row="0" Grid.Column="0" Text="Shell Number *"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtShellNumber" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblLastRegNumber" Grid.Row="0" Grid.Column="3" Text="Last Registration Number"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtLastRegistrationNumber" Grid.Row="0" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>

                            <!-- Row 1 -->
                            <TextBlock x:Name="LblEngineNumber" Grid.Row="1" Grid.Column="0" Text="Engine Number"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtEngineNumber" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblFirstRegNumber" Grid.Row="1" Grid.Column="3" Text="First Registration Number"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtFirstRegistrationNumber" Grid.Row="1" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>

                            <!-- Row 2 -->
                            <TextBlock x:Name="LblMakeDate" Grid.Row="2" Grid.Column="0" Text="Make Date"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <DatePicker x:Name="DpMakeDate" Grid.Row="2" Grid.Column="1"
                                        Style="{StaticResource FieldDatePicker}"/>

                            <TextBlock x:Name="LblFirstRegDate" Grid.Row="2" Grid.Column="3" Text="First Registration Date"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <DatePicker x:Name="DpFirstRegistrationDate" Grid.Row="2" Grid.Column="4"
                                        Style="{StaticResource FieldDatePicker}"/>

                            <!-- Row 3 -->
                            <TextBlock x:Name="LblLastRegDate" Grid.Row="3" Grid.Column="3" Text="Last Registration Date"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <DatePicker x:Name="DpLastRegistrationDate" Grid.Row="3" Grid.Column="4"
                                        Style="{StaticResource FieldDatePicker}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Classification -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblClassification" Text="Classification" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 -->
                            <TextBlock x:Name="LblVehicleModel" Grid.Row="0" Grid.Column="0" Text="Vehicle Model"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerVehicleModel" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblUseType" Grid.Row="0" Grid.Column="3" Text="Use Type"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerUseType" Grid.Row="0" Grid.Column="4" Margin="0,0,0,12"/>

                            <!-- Row 1 -->
                            <TextBlock x:Name="LblCategory" Grid.Row="1" Grid.Column="0" Text="Category"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerCategory" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblBodyType" Grid.Row="1" Grid.Column="3" Text="Body Type"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerBodyType" Grid.Row="1" Grid.Column="4" Margin="0,0,0,12"/>

                            <!-- Row 2 -->
                            <TextBlock x:Name="LblPaymentCategory" Grid.Row="2" Grid.Column="0" Text="Payment Category"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerPaymentCategory" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Engine -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblEngine" Text="Engine" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 -->
                            <TextBlock x:Name="LblEngineType" Grid.Row="0" Grid.Column="0" Text="Engine Type"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerEngineType" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblEngineNum2" Grid.Row="0" Grid.Column="3" Text="Engine Number"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtEngineNumber2" Grid.Row="0" Grid.Column="4"
                                     Style="{StaticResource FieldBox}" IsReadOnly="True"/>

                            <!-- Row 1 -->
                            <TextBlock x:Name="LblEnginePower" Grid.Row="1" Grid.Column="0" Text="Power (KW)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtEnginePowerKW" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblEngineTorque" Grid.Row="1" Grid.Column="3" Text="Torque (NM)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtEngineTorqueNM" Grid.Row="1" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>

                            <!-- Row 2 -->
                            <TextBlock x:Name="LblEngineCapacity" Grid.Row="2" Grid.Column="0" Text="Capacity (CM3)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtEngineWorkingCapacityCM3" Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblMaxSpeed" Grid.Row="2" Grid.Column="3" Text="Max Speed (km/h)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtMaxSpeedKMH" Grid.Row="2" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>

                            <!-- Row 3 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Eco Program"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerEcoProgram" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="3" Grid.Column="3" Text="Primary Fuel"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerPrimaryFuel" Grid.Row="3" Grid.Column="4" Margin="0,0,0,12"/>

                            <!-- Row 4 -->
                            <TextBlock Grid.Row="4" Grid.Column="3" Text="Secondary Fuel"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <controls:SearchableLookupPicker x:Name="PickerSecondaryFuel" Grid.Row="4" Grid.Column="4" Margin="0,0,0,12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 4: Dimensions & Weight -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblDimensions" Text="Dimensions" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 -->
                            <TextBlock x:Name="LblLength" Grid.Row="0" Grid.Column="0" Text="Length (mm)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtLengthMM" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblEmptyWeight" Grid.Row="0" Grid.Column="3" Text="Empty Weight (kg)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtEmptyWeightKG" Grid.Row="0" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>

                            <!-- Row 1 -->
                            <TextBlock x:Name="LblWidth" Grid.Row="1" Grid.Column="0" Text="Width (mm)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtWidthMM" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblMaxWeight" Grid.Row="1" Grid.Column="3" Text="Max Allowed Weight (kg)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtMaxAllowedWeightKG" Grid.Row="1" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>

                            <!-- Row 2 -->
                            <TextBlock x:Name="LblHeight" Grid.Row="2" Grid.Column="0" Text="Height (mm)"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtHeightMM" Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 5: Seating & Axles -->
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblSeating" Text="Seating" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 -->
                            <TextBlock x:Name="LblNumberOfDoors" Grid.Row="0" Grid.Column="0" Text="Number of Doors"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtNumberOfDoors" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblNumberOfSeats" Grid.Row="0" Grid.Column="3" Text="Number of Seats"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtNumberOfSeats" Grid.Row="0" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>

                            <!-- Row 1 -->
                            <TextBlock x:Name="LblNumberOfAxles" Grid.Row="1" Grid.Column="0" Text="Number of Axles"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtNumberOfAxles" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock x:Name="LblNumberOfWheels" Grid.Row="1" Grid.Column="3" Text="Number of Wheels"
                                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,12"/>
                            <TextBox x:Name="TxtNumberOfWheels" Grid.Row="1" Grid.Column="4"
                                     Style="{StaticResource FieldBox}"/>

                            <!-- Row 2: Checkboxes -->
                            <CheckBox x:Name="ChkHasLPG" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="  Has LPG" Foreground="{DynamicResource TextSecondary}" FontSize="13"
                                      VerticalAlignment="Center" Margin="0,0,0,12"/>

                            <CheckBox x:Name="ChkHasHook" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"
                                      Content="  Has Hook" Foreground="{DynamicResource TextSecondary}" FontSize="13"
                                      VerticalAlignment="Center" Margin="0,0,0,12"/>
                        </Grid>

                        <!-- Separator + Buttons inside card -->
                        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnSave" Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnDelete" Content="Delete" Style="{StaticResource DeleteButton}" Click="Delete_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource CancelButton}" Click="Back_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Hidden fields for code-behind compatibility -->
                <TextBlock x:Name="LblOther" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
