<Window
    x:Class="VTE.WPF.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VTE - Login"
    Width="450" Height="500"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent">

    <Window.Resources>
        <!-- Label style for field headers -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#a6adc8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <!-- Outer border acts as a subtle drop shadow via layered borders -->
    <Border CornerRadius="12" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a1a2e" Offset="0"/>
                <GradientStop Color="#16213e" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <!-- Inner card -->
        <Border CornerRadius="10" Background="#1e1e2e" BorderBrush="#313244" BorderThickness="1"
                Margin="24" Padding="32,28">
            <StackPanel VerticalAlignment="Center">

                <!-- Accent shape + Logo -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Border Width="64" Height="64" CornerRadius="14"
                            HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#667eea" Offset="0"/>
                                <GradientStop Color="#764ba2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="VTE" Foreground="White" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Title -->
                <TextBlock x:Name="TxtWelcome" Text="Добредојдовте"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,4"/>

                <!-- Subtitle -->
                <TextBlock x:Name="TxtSubtitle" Text="Систем за технички преглед на возила"
                           Foreground="#6c7086" FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <!-- Username label -->
                <TextBlock x:Name="TxtUsernameLabel" Text="Корисничко име" Style="{StaticResource FieldLabel}"/>

                <!-- Username input (rounded) -->
                <Border CornerRadius="6" Background="#313244" BorderBrush="#45475a" BorderThickness="1"
                        Margin="0,0,0,16">
                    <TextBox x:Name="UsernameBox"
                             Background="Transparent" BorderThickness="0"
                             Foreground="White" CaretBrush="White"
                             Padding="12,10" FontSize="14"/>
                </Border>

                <!-- Password label -->
                <TextBlock x:Name="TxtPasswordLabel" Text="Лозинка" Style="{StaticResource FieldLabel}"/>

                <!-- Password input (rounded) -->
                <Border CornerRadius="6" Background="#313244" BorderBrush="#45475a" BorderThickness="1"
                        Margin="0,0,0,8">
                    <PasswordBox x:Name="PasswordBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="White" CaretBrush="White"
                                 Padding="12,10" FontSize="14"
                                 KeyDown="PasswordBox_KeyDown"/>
                </Border>

                <!-- Error message -->
                <TextBlock x:Name="ErrorText"
                           Foreground="#f38ba8"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           MaxWidth="300"
                           Margin="0,4,0,8"
                           FontSize="12"
                           Visibility="Collapsed"/>

                <!-- Login button with gradient -->
                <Button x:Name="LoginButton"
                        Content="Најави се"
                        FontSize="14" FontWeight="SemiBold"
                        Foreground="White"
                        Cursor="Hand"
                        Margin="0,10,0,0"
                        Click="LoginButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6" Padding="12,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#667eea" Offset="0"/>
                                        <GradientStop Color="#764ba2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Version text -->
                <TextBlock Text="v2.0"
                           Foreground="#585b70" FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Border>
</Window>
