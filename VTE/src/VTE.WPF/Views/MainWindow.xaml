<Window
    x:Class="VTE.WPF.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VTE - Vehicle Technical Examination System"
    Width="1280" Height="850"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource WindowBg}">

    <Window.Resources>
        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Margin" Value="18,18,16,6"/>
        </Style>

        <!-- Nav button style -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NavText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBd" Background="Transparent" CornerRadius="6" Padding="14,9" Margin="6,1,6,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Grid.Column="0" Width="3" CornerRadius="2" Background="Transparent" Margin="0,2,8,2"/>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource NavText}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                <Setter TargetName="AccentBar" Property="Background" Value="#667eea"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SidebarBg}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Branding area -->
                    <StackPanel Margin="20,24,16,16">
                        <TextBlock Text="VTE" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="TxtBrandingSub" Text="Technical Examination" FontSize="10" Foreground="{DynamicResource TextDimmed}" Margin="0,2,0,0"/>
                        <Border Height="3" Width="40" HorizontalAlignment="Left" CornerRadius="2" Margin="0,10,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#667eea" Offset="0"/>
                                    <GradientStop Color="#764ba2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Height="1" Margin="16,0,16,8" Opacity="0.15" Background="#6c7086"/>

                    <!-- OPERATIONS section -->
                    <Border Style="{StaticResource SectionHeader}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="2" Height="10" CornerRadius="1" Margin="0,0,8,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#667eea" Offset="0"/>
                                        <GradientStop Color="#764ba2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock x:Name="TxtNavOperations" Text="OPERATIONS" FontSize="10" Foreground="{DynamicResource TextDimmed}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnDashboard" Content="Dashboard" Click="OnNavDashboard" Style="{StaticResource NavBtn}"/>
                    <Button x:Name="BtnCustomers" Content="Customers" Click="OnNavCustomers" Style="{StaticResource NavBtn}"/>
                    <Button x:Name="BtnVehicles" Content="Vehicles" Click="OnNavVehicles" Style="{StaticResource NavBtn}"/>
                    <Button x:Name="BtnRequests" Content="Requests" Click="OnNavRequests" Style="{StaticResource NavBtn}"/>
                    <Button x:Name="BtnExams" Content="Technical Exams" Click="OnNavExams" Style="{StaticResource NavBtn}"/>
                    <Button x:Name="BtnDocuments" Content="Documents" Click="OnNavDocuments" Style="{StaticResource NavBtn}"/>
                    <Button x:Name="BtnPayments" Content="Payments" Click="OnNavPayments" Style="{StaticResource NavBtn}"/>
                    <Button x:Name="BtnTrafficLic" Content="Сообраќајни дозволи" Click="OnNavTrafficLicenses" Style="{StaticResource NavBtn}"/>
                    <Button x:Name="BtnIntlLic" Content="Меѓународни дозволи" Click="OnNavIntlLicenses" Style="{StaticResource NavBtn}"/>
                    <Button x:Name="BtnRelations" Content="Врски" Click="OnNavRelations" Style="{StaticResource NavBtn}"/>
                    <Button x:Name="BtnPermissions" Content="Дозволи" Click="OnNavPermissions" Style="{StaticResource NavBtn}"/>

                    <!-- ANALYTICS section -->
                    <Border Style="{StaticResource SectionHeader}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="2" Height="10" CornerRadius="1" Margin="0,0,8,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#667eea" Offset="0"/>
                                        <GradientStop Color="#764ba2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock x:Name="TxtNavAnalytics" Text="ANALYTICS" FontSize="10" Foreground="{DynamicResource TextDimmed}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnReports" Content="Reports" Click="OnNavReports" Style="{StaticResource NavBtn}"/>

                    <!-- CONFIGURATION section -->
                    <Border Style="{StaticResource SectionHeader}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="2" Height="10" CornerRadius="1" Margin="0,0,8,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#667eea" Offset="0"/>
                                        <GradientStop Color="#764ba2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock x:Name="TxtNavConfiguration" Text="CONFIGURATION" FontSize="10" Foreground="{DynamicResource TextDimmed}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnLookups" Content="Lookups" Click="OnNavLookups" Style="{StaticResource NavBtn}"/>
                    <Button x:Name="BtnCompanies" Content="Organizations" Click="OnNavCompanies" Style="{StaticResource NavBtn}"/>
                    <Button x:Name="BtnAdmin" Content="Administration" Click="OnNavAdmin" Style="{StaticResource NavBtn}"/>

                    <!-- Sync + Theme Toggle -->
                    <Border Height="1" Margin="16,16,16,8" Opacity="0.15" Background="#6c7086"/>
                    <Button x:Name="BtnSync" Content="&#x1F504; Синхронизирај" Click="OnSync"
                            Style="{StaticResource NavBtn}" Margin="6,4,6,1"/>
                    <Button x:Name="BtnThemeToggle" Content="&#x2600; Light Mode" Click="OnToggleTheme"
                            Style="{StaticResource NavBtn}" Margin="6,1,6,1"/>
                    <Button x:Name="BtnLanguageToggle" Content="English" Click="OnToggleLanguage"
                            Style="{StaticResource NavBtn}" Margin="6,1,6,12"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Sidebar / content separator -->
        <Border Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" Width="1" Opacity="0.2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#667eea" Offset="0.3"/>
                    <GradientStop Color="#764ba2" Offset="0.7"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="0" Grid.Column="1" Background="{DynamicResource PageBg}" Margin="24,20,24,20">
            <ContentControl x:Name="ContentArea"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource StatusBarBg}" Padding="14,8">
            <Border.BorderBrush>
                <SolidColorBrush Color="#313244"/>
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness Top="1" Left="0" Right="0" Bottom="0"/>
            </Border.BorderThickness>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#a6e3a1"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource TextDimmed}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtStation" Text="Main Station" Foreground="{DynamicResource TextDimmed}" FontSize="12" Margin="0,0,20,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="TxtCurrentUser" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
